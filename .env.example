# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=gps_heatmap

# Backend - Database
DATABASE_URL=postgresql://user:password@postgres/gps_heatmap

# Backend - Redis
REDIS_URL=redis://redis:6379

# Backend - Auth
ENVIRONMENT=development
JWT_SECRET=change_me
JWT_EXPIRES_DAYS=30

# Backend - CORS (dev-only; prod is same-origin behind nginx, see deploy/nginx.conf)
CORS_ORIGINS=http://localhost:5173

# Backend - External Services
RESEND_API_KEY=
# Must be on a domain verified at resend.com/domains, or leave as the
# sandbox sender below for local testing (only delivers to your own
# Resend account email until you verify a real domain).
RESEND_FROM_EMAIL=onboarding@resend.dev
ORS_API_KEY=

# Backend - Configuration
MAX_FILE_SIZE_MB=20
NOMINATIM_USER_AGENT=gps-heatmap/1.0 (change-me@example.com)

# Base URL for links in outgoing emails (password reset). Set to your real
# domain in production — e.g. https://your-domain.example
FRONTEND_URL=http://localhost:5173
